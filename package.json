{
  "name": "lcards",
  "version": "2026.10.0-dev.2",
  "type": "module",
  "description": "LCARdS - LCARS card system for Home Assistant",
  "main": "index.js",
  "author": "Jason Weyermars",
  "license": "MIT",
  "homepage": "https://lcards.unimatrix01.ca",
  "directories": {
    "doc": "doc"
  },
  "keywords": [
    "HomeAssistant",
    "Home Assistant",
    "HASS",
    "LCARS",
    "Star Trek"
  ],
  "scripts": {
    "help": "node scripts/help.js",
    "build": "node scripts/validate-doc-examples.js --strict && node scripts/check-schema-descriptions.js && node scripts/check-doc-em-dashes.js && node scripts/validate-css-vars.js && node scripts/validate-ha-compat.js && node scripts/set-version.js && vite build --mode integration && node scripts/copy-assets.js",
    "validate:css-vars": "node scripts/validate-css-vars.js",
    "validate:css-vars:verbose": "node scripts/validate-css-vars.js --verbose",
    "validate:ha-compat": "node scripts/validate-ha-compat.js",
    "validate:doc-examples": "node scripts/validate-doc-examples.js",
    "validate:doc-examples:strict": "node scripts/validate-doc-examples.js --strict",
    "check:ha-impact": "node scripts/check-ha-impact.js",
    "check:ha-impact:quick": "node scripts/check-ha-impact.js --quick",
    "generate:llm-schema": "node scripts/generate-llm-schema.js",
    "validate:config": "node scripts/lcards-validate.mjs",
    "gallery:shots": "node scripts/dashboard-shots.mjs doc/gallery/dashboards/*.yaml --video",
    "build:validator": "node scripts/build-validator.js",
    "build:skill": "node scripts/build-user-skill.js",
    "validate:schema-descriptions": "node scripts/check-schema-descriptions.js",
    "validate:schema-descriptions:update": "node scripts/check-schema-descriptions.js --update",
    "build:integration": "vite build --mode integration && node scripts/copy-assets.js",
    "set-version": "node scripts/set-version.js",
    "bump-version": "node scripts/bump-version.js",
    "bump-version:dev": "node scripts/bump-version.js --dev",
    "generate-brand-icon": "node scripts/generate-brand-icon.js",
    "typecheck": "tsc --pretty false 2>&1 | sort",
    "typecheck:check": "node scripts/check-typecheck-baseline.js",
    "test": "node --import ./tests/setup/browser-shims.js --import ./tests/setup/vite-imports.js --test 'tests/**/*.test.js'",
    "test:routing": "node --import ./tests/setup/browser-shims.js --import ./tests/setup/vite-imports.js --test 'tests/routing/*.test.js'",
    "test:data-grid": "node --import ./tests/setup/browser-shims.js --import ./tests/setup/vite-imports.js --test 'tests/data-grid/*.test.js'",
    "create-editor": "node tools/create-editor.js",
    "docs:build": "node scripts/generate-llm-schema.js && node scripts/build-validator.js && node scripts/build-user-skill.js && npm run docs:bundle && vitepress build doc && node scripts/generate-llms-txt.js && node scripts/check-doc-anchors.js && node scripts/check-docs-base.js",
    "docs:serve": "node scripts/generate-llm-schema.js && vitepress dev doc",
    "docs:serve:network": "node scripts/generate-llm-schema.js && vitepress dev doc --host",
    "docs:preview": "vitepress preview doc",
    "docs:routing-diagrams": "node scripts/generate-routing-diagrams.js",
    "lcars:palette-scale": "node scripts/generate-lcards-palette-scale.js",
    "lcars:palette-scale:write": "node scripts/generate-lcards-palette-scale.js --write && cp reports/palette-scale-review.html doc/public/reports/palette-scale-review.html",
    "lcars:semantic-tokens": "node scripts/generate-lcards-ha-semantic-tokens.js",
    "lcars:semantic-tokens:write": "node scripts/generate-lcards-ha-semantic-tokens.js --write",
    "lcars:generate-themes": "cd ../ha-lcars && python3 py/generate_themes.py",
    "lcars:export-vendored": "node scripts/export-vendored-ha-lcars-theme.js --write",
    "lcars:export-all-themes": "node scripts/export-vendored-ha-lcars-all-themes.js --write",
    "lcars:regenerate": "npm run lcars:semantic-tokens:write && npm run lcars:generate-themes && npm run build && npm run lcars:export-vendored && npm run lcars:export-all-themes",
    "test:browser": "playwright test --project=component",
    "test:visual": "playwright test --project=visual",
    "test:ha": "playwright test -c playwright.ha.config.js",
    "docs:check-anchors": "node scripts/check-doc-anchors.js",
    "docs:check-base": "node scripts/check-docs-base.js",
    "docs:llms-txt": "node scripts/generate-llms-txt.js",
    "docs:bundle": "vite build --mode integration && node scripts/copy-assets.js && node scripts/copy-docs-bundle.js",
    "test:docs": "playwright test -c playwright.docs.config.js",
    "release:notes": "node scripts/release-notes.mjs export",
    "release:check": "node scripts/release-notes.mjs check",
    "release:shots": "node scripts/release-shots.mjs",
    "release:commits": "node scripts/release-notes.mjs commits"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "ajv": "^8.20.0",
    "inquirer": "^13.1.0",
    "jsdom": "^29.0.1",
    "mermaid": "^11.13.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitepress-plugin-tabs": "^0.8.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.4",
    "@fsegurai/codemirror-theme-vscode-dark": "^6.2.3",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "animejs": "^4.3.6",
    "apexcharts": "^7.8.0",
    "custom-card-helpers": "^2.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "js-yaml": "^4.1.0",
    "lit": "^3.3.2",
    "vanilla-colorful": "^0.7.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
