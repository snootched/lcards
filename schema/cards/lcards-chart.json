is labels"}},"required":["id"],"additionalProperties":false},"examples":[[{"id":"temp"},{"id":"humidity","opposite":true,"min":0,"max":100}]]},"data_sources":{"type":"object","description":"Data sources for real-time entity tracking, historical data, and processing pipelines. Each key defines a named data source accessible in templates.","$comment":"Data sources enable entity subscriptions, history preload, and unified processing pipeline","examples":[{"temp":{"entity":"sensor.temperature","history":{"hours":6},"processing":{"fahrenheit":{"type":"convert_unit","from":"c","to":"f"},"smoothed":{"type":"smooth","input_source":"fahrenheit","method":"exponential","alpha":0.3},"rounded":{"type":"round","input_source":"smoothed","precision":1}}},"power":{"entity":"sensor.power","update_interval":1000,"processing":{"kilowatts":{"type":"scale","input_range":[0,1000],"output_range":[0,1]}}}}],"additionalProperties":{"type":"object","properties":{"entity":{"type":"string","format":"entity","pattern":"^[a-z_]+\\.[a-z0-9_]+$","description":"Entity ID to track (format: domain.object_id)","examples":["sensor.temperature"]},"attribute":{"type":"string","description":"Entity attribute to track instead of state","examples":["temperature"]},"enum_mapping":{"type":"object","description":"Map non-numeric states to numbers so they can be plotted or processed (on/off map to 1/0 automatically)","additionalProperties":{"type":"number"},"examples":[{"heat":2,"cool":1,"off":0}]},"update_interval":{"type":"number","minimum":0,"maximum":10000,"description":"Minimum milliseconds between updates (throttling, default: 100)","examples":[100]},"history":{"type":"object","description":"Historical data preload configuration","properties":{"enabled":{"type":"boolean","description":"Enable historical data preload (default: true)"},"hours":{"type":"number","minimum":1,"maximum":168,"description":"Hours of history to preload (1-168, default: 6)"},"days":{"type":"number","minimum":1,"maximum":7,"description":"Days of history to preload (1-7)"}}},"processing":{"type":"object","description":"Processing pipeline with named processors. Each processor transforms data and stores results in a buffer accessible via templates.","additionalProperties":{"type":"object","properties":{"type":{"type":"string","enum":["convert_unit","scale","smooth","expression","statistics","rate","trend","duration","threshold","clamp","round","delta"],"description":"Processor type","examples":["convert_unit"]},"input_source":{"type":"string","description":"Name of another processor in this pipeline whose output this one reads (creates a dependency chain). If omitted, uses the raw entity value.","examples":["fahrenheit"]},"enabled":{"type":"boolean","description":"Set false to pass values through unchanged (default true)"},"from":{"type":"string","description":"convert_unit: source unit (e.g. c, f, w, kw). Not a chaining key: use input_source."},"to":{"type":"string","description":"convert_unit: target unit"},"input_range":{"type":"array","items":{"type":"number"},"description":"scale: [min, max] of the input"},"output_range":{"type":"array","items":{"type":"number"},"description":"scale: [min, max] of the output"},"curve":{"type":"string","enum":["linear","exponential","logarithmic","sigmoid"],"description":"scale: mapping curve"},"method":{"type":"string","description":"smooth: exponential | moving_average | gaussian. round: round | floor | ceil"},"alpha":{"type":"number","description":"smooth (exponential): weight of the newest value, 0 to 1 (default 0.3)"},"window":{"type":["number","string"],"description":"smooth: sample count (default 10). statistics: time window like \"5m\" or \"session\""},"expression":{"type":"string","description":"expression: JavaScript expression using value/v, t, sources, entity and Math helpers"},"sources":{"type":"array","items":{"type":"string"},"description":"expression: processor names available as sources[0], sources[1], ..."},"stats":{"type":"array","items":{"t