{"$schema":"http://json-schema.org/draft-07/schema#","$comment":"LCARdS 2026.10.0-dev.1: generated from src/cards/schemas/ by scripts/generate-llm-schema.js; do not hand-edit.","title":"LCARdS Chart Card Configuration","description":"Complete configuration schema for lcards-chart custom card (v1.18.0+ nested structure)","type":"object","properties":{"type":{"type":"string","const":"custom:lcards-chart","description":"Home Assistant card type identifier (required)"},"id":{"type":"string","pattern":"^[a-zA-Z0-9_-]+$","description":"Custom card ID for rule targeting (optional - auto-generated if omitted)","examples":["main-button"]},"tags":{"type":"array","items":{"type":"string","pattern":"^[a-zA-Z0-9_-]+$"},"description":"Tags for bulk rule targeting and grouping. Allows applying rules to multiple cards at once using tag selectors.","examples":[["navigation","primary"]]},"sources":{"type":"array","description":"Chart series. Each item plots an entity (history or long-term statistics) or a named DataSource buffer.","items":{"anyOf":[{"type":"object","title":"Entity series","properties":{"entity":{"type":"string","format":"entity","pattern":"^[a-z_]+\\.[a-z0-9_]+$","description":"Entity to plot (history is fetched from Home Assistant)"},"attribute":{"type":"string","description":"Plot this attribute instead of the state"},"statistics":{"type":"object","description":"Use long-term statistics instead of state history (sensors with a state_class)","properties":{"type":{"type":"string","enum":["mean","min","max","sum","state","change"],"default":"mean","description":"Which statistic to plot"},"period":{"type":"string","enum":["5minute","hour","day","week","month"],"default":"hour","description":"Statistics period"}},"additionalProperties":false},"name":{"type":"string","description":"Legend name (default: entity friendly name or source id)"},"unit":{"type":"string","description":"Unit shown in tooltips and axis labels (default: entity unit_of_measurement)"},"float_precisio