{
    "compilerOptions": {
        // Check JS files without renaming anything to .ts
        "allowJs": true,
        "checkJs": true,

        // Never emit compiled output — this is editor/IDE checking only
        "noEmit": true,

        // Browser + custom elements environment
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",

        // See doc/development/typescript.md for what each setting is for.
        // Zero errors is enforced (npm run typecheck, inside npm run build and CI).
        "strict": false,
        // Off on purpose: it would demand a type on every parameter TypeScript can't
        // infer (~12,600 places), busywork with little bug-finding value in JS.
        "noImplicitAny": false,

        // Flags values that may be null/undefined where an object is used.
        "strictNullChecks": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,

        // Allow default imports from CommonJS modules (animejs, apexcharts, etc.)
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,

        // Preserve JSDoc comments in the language service
        "preserveValueImports": false,

        "skipLibCheck": true
    },
    "include": [
        "src/**/*.js",
        "src/types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "doc",
        "doc-staging",
        "doc-temp",
        "cb-archive",
        "tests"
    ]
}
